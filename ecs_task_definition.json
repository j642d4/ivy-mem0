{
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<ER_ARN>",
    "containerDefinitions": [
        {
            "name": "<C_NAME>",
            "image": "<ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/<ECR_REPOSITORY_NAME>:<TAG>",
            "cpu": 1024,
            "memory": 2048,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PORT1",
                    "value": "3000"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "<AWS_LG>",
                    "awslogs-region": "<AWS_REGION>",
                    "awslogs-stream-prefix": "<AWS_SP>"
                }
            },
            "systemControls": []
        }
    ],
    "family": "<T_FAMILY>",
    "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<TR_ARN>",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "volumes": [],
    "placementConstraints": []
}
